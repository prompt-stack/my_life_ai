# Public, non-secret values only: EXPO_PUBLIC_* is inlined into the app bundle. Never put keys here.
# Copy to .env and restart Metro after changing it.

# Base URL of the MyLife AI API, used by RELEASE builds (and as a dev fallback).
# Development builds auto-detect the Mac's current LAN IP from the Metro dev server
# the app loaded its bundle from, so you do NOT need to update this when the IP changes.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: API port used with the auto-detected host in dev (default 3000).
# EXPO_PUBLIC_API_PORT=3000

# Optional: force a fixed API URL in dev, skipping auto-detection (tunnels, remote backend).
# EXPO_PUBLIC_API_URL_OVERRIDE=https://my-tunnel.example.com
