# Public, non-secret values only: EXPO_PUBLIC_* is inlined into the app bundle. Never put keys here.
# Copy to .env and restart Metro after changing it.

# Base URL of the MyLife AI API.
# - iOS Simulator: http://localhost:3000 works.
# - Physical phone (e.g. Poco F9 Pro): use the Mac's LAN IP, e.g. http://192.168.1.20:3000
#   (find it with `ipconfig getifaddr en0`). Phone and Mac must be on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:3000
