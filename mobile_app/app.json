{
  "expo": {
    "name": "MyLife AI",
    "slug": "mylife-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mylifeai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mylifeai.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "MyLife AI turns your speech into text so the assistant can understand your requests.",
        "NSMicrophoneUsageDescription": "MyLife AI listens to your voice so you can ask it to do things."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mylifeai.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-disable-force-dark",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MyLife AI listens to your voice so you can ask it to do things.",
          "speechRecognitionPermission": "MyLife AI turns your speech into text so the assistant can understand your requests.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./modules/mylife-alarms/app.plugin.js",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fe76c829-32c5-4b68-92d7-1bc152a6ca06"
      }
    },
    "owner": "reypatoy"
  }
}
