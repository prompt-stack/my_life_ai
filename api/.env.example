# MyLife AI API environment variables.
# Copy to .env for local development (`pnpm dev` loads it via node --env-file-if-exists).
# Never commit a real .env file.

# --- Active (Phase 0) ---------------------------------------------------------
# development | test | production
NODE_ENV=development
# HTTP port (1-65535)
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS. Native mobile requests send no
# Origin header and are unaffected. Leave empty to allow no browser origins.
CORS_ORIGINS=http://localhost:8081
# Number of trusted reverse-proxy hops (0 = trust none). Set to 1 behind a single
# load balancer so rate limiting sees the real client IP.
TRUST_PROXY=0
# IANA timezone used when a user has no timezone set.
DEFAULT_TIMEZONE=Asia/Manila

# --- Future (not read yet; uncomment when the phase lands) --------------------
# Phase 1: Supabase (JWT verification, data access)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# Phase 1: OpenAI (Agents SDK)
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Phase 2+: Redis (BullMQ queues, cache, rate-limit store)
# REDIS_URL=redis://localhost:6379

# Phase 5: Google OAuth + token encryption
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# INTEGRATIONS_ENCRYPTION_KEY=

# Phase 5: Web search provider
# SEARCH_API_KEY=

# Phase 6: Expo push
# EXPO_ACCESS_TOKEN=
