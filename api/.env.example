# Phase 5: Google OAuth + token encryption
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# INTEGRATIONS_ENCRYPTION_KEY=

# Phase 5: Web search provider
# SEARCH_API_KEY=

# Phase 6: Expo push
# EXPO_ACCESS_TOKEN=
