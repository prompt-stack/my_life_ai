# MyLife AI API environment variables.
# Copy to .env for local development (`pnpm dev` loads it via node --env-file-if-exists).
# Never commit a real .env file.

# --- Active (Phase 0) ---------------------------------------------------------
# development | test | production
NODE_ENV=development
# HTTP port (1-65535)
PORT=3000
# Interface to bind. 0.0.0.0 lets a phone on the same Wi-Fi (and Docker) reach the
# API at http://<this-computer's-LAN-IP>:PORT. Use 127.0.0.1 to stay local-only.
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS. Native mobile requests send no
# Origin header and are unaffected. Leave empty to allow no browser origins.
CORS_ORIGINS=http://localhost:8081
# Number of trusted reverse-proxy hops (0 = trust none). Set to 1 behind a single
# load balancer so rate limiting sees the real client IP.
TRUST_PROXY=0
# IANA timezone used when a user has no timezone set.
DEFAULT_TIMEZONE=Asia/Manila

# --- Active: AI provider (Groq) ----------------------------------------------
# The AI provider is Groq. Create a free key at https://console.groq.com/keys
# SERVER ONLY: never put this key in mobile_app/, the repo, logs or chat.
# Optional at startup: without it the API still runs and POST /voice answers
# 503 ai_not_configured.
# Free tier is roughly 30 requests/min, 1K requests/day and 8K tokens/min per
# org (check the console for current limits); hitting them returns 429
# ai_rate_limited to the app.
GROQ_API_KEY=
# Model ID. Switch models by editing only this line, then restart `pnpm dev`.
# Groq adds and retires models often, so check the current list before switching:
#   https://console.groq.com/docs/models
#   https://console.groq.com/docs/deprecations
# Examples (both are reasoning models):
#   openai/gpt-oss-20b    fastest (default, good for voice)
#   openai/gpt-oss-120b   smarter, a bit slower
GROQ_MODEL=openai/gpt-oss-20b
# Max completion tokens per reply (16-8192). Reasoning tokens count toward this
# limit, so don't set it too low or replies can come back empty.
GROQ_MAX_TOKENS=1024
# Reasoning effort for reasoning models: low | medium | high (also none | default
# for models that support them). `low` keeps voice replies fast. Set `off` for a
# non-reasoning model: it omits reasoning_effort and include_reasoning, which
# such models reject (400 in the API logs).
GROQ_REASONING_EFFORT=low

